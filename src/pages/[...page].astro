---
export const prerender = true;


import type { GetStaticPaths } from "astro";

import { PAGE_SIZE } from "@constants/constants";
import { getSortedPosts } from "@utils/post";
import Pagination from "@components/pagination.astro";
import PostPage from "@components/postPage.astro";
import HomePanels from "@components/home/HomePanels.astro";
import PersonJsonLd from "@components/seo/PersonJsonLd.astro";
import GridLayout from "@layouts/grid.astro";


export const getStaticPaths = (async ({ paginate }) => {
    const allBlogPosts = await getSortedPosts();
    return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992


const { page } = Astro.props;

const len = page.data.length;
// The first page of the paginated home view always shows the three swiping
// panels (LinkedIn, YouTube, Ecohydraulics). When posts exist, the paginated
// post list is rendered underneath. Subsequent pages render the post list only.
const isFirstPage = page.currentPage === 1;
const showHomePanels = isFirstPage;
const showPosts = len > 0;
---

<GridLayout
    fullWidthAtMd={showHomePanels}
    description="Personal site of PD Dr. sc. (PhD) Sebastian Schwindt — research, teaching, and outreach on ecohydraulics, hydro-morphodynamics, TELEMAC numerical simulations, large wood, fish passage, sediment transport and climate-aware river restoration at the University of Stuttgart (IWS)."
>
    {isFirstPage && <PersonJsonLd slot="head" />}
    {showHomePanels && <HomePanels />}
    {showPosts && (
        <>
            <PostPage page={page}></PostPage>
            <Pagination class="mx-auto onload-animation-up" page={page} style={`animation-delay: ${(len)*50}ms`}></Pagination>
        </>
    )}
</GridLayout>
