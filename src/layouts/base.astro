---
import "katex/dist/katex.css";

import { siteConfig, profileConfig, musicPlayerConfig, pioConfig } from "@/config";
import { getAnalyticsConfig } from "@utils/analytics";
import type { Favicon } from "@/types/config";
import { defaultFavicons } from "@constants/icon";
import {
    BANNER_HEIGHT,
    BANNER_HEIGHT_EXTEND,
    BANNER_HEIGHT_HOME,
    LIGHT_MODE,
    DARK_MODE,
    SYSTEM_MODE,
    PAGE_WIDTH,
    NAVBAR_HEIGHT,
    NAVBAR_GAP,
    NAVBAR_FOLLOW_DISTANCE,
    MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
    SIDEBAR_TOP,
    SIDEBAR_SPACING,
} from "@constants/constants";
import { pathsEqual, url } from "@utils/url";
import FontLoader from "@components/fontLoader.astro";
import LoadingOverlay from "@components/loadingOverlay.astro";
import ConfigCarrier from "@components/configCarrier.astro";
import MusicPlayer from "@components/musicPlayer.svelte";
import Pio from "@components/pio.svelte";
import CookieConsent from "@components/cookieConsent.astro";
import "@styles/navbar.css";
import "@styles/banner.css";
import "@styles/fancybox.css";


interface Props {
    title?: string;
    banner?: string;
    description?: string;
    lang?: string;
    setOGTypeArticle?: boolean;
    postSlug?: string;
}

let { title, banner, description, lang, setOGTypeArticle, postSlug } = Astro.props;

// apply a class to the body element to decide the height of the banner, only used for initial page load
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// defines global css variables
// why doing this in BaseLayout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;

// Get the navbar transparency mode configuration
const navbarTransparentMode =
    siteConfig.wallpaper.banner?.navbar?.transparentMode || "semi";
// Determine whether to show the top highlight effect (only in full and semifull modes)
const shouldShowTopHighlight =
    navbarTransparentMode === "full" || navbarTransparentMode === "semifull";

// Helper function to get the default banner image
const getDefaultBanner = (): string => {
    const src = siteConfig.wallpaper.src;
    if (typeof src === "string") {
        return src;
    }
    if (Array.isArray(src)) {
        return src[0] || "";
    }
    if (src && typeof src === "object") {
        // Prefer desktop, fall back to mobile if unavailable
        const desktopSrc = src.desktop;
        const mobileSrc = src.mobile;
        if (typeof desktopSrc === "string") {
            return desktopSrc;
        }
        if (Array.isArray(desktopSrc) && desktopSrc.length > 0) {
            return desktopSrc[0];
        }
        if (typeof mobileSrc === "string") {
            return mobileSrc;
        }
        if (Array.isArray(mobileSrc) && mobileSrc.length > 0) {
            return mobileSrc[0];
        }
    }
    return "";
};

// TODO don't use post cover as banner for now
banner = getDefaultBanner();

const enableBanner = siteConfig.wallpaper.mode === "banner";

let pageTitle: string;
if (title) {
    pageTitle = `${title} - ${siteConfig.title}`;
} else {
    pageTitle = siteConfig.subtitle
        ? `${siteConfig.title} - ${siteConfig.subtitle}`
        : siteConfig.title;
}

// Browser tab/window title: always the author's name and identical in every
// language (a proper name is left untranslated by translate.js). The landing
// page banner title/subtitle and the descriptive og:title/description below
// keep using pageTitle.
const browserTitle = profileConfig.name;

let ogImageUrl: string | undefined;
if (siteConfig.generateOgImages && postSlug) {
    ogImageUrl = new URL(`/og/${postSlug}.png`, Astro.site).toString();
}

const favicons: Favicon[] =
    siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
    lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
    top: `${BANNER_HEIGHT_EXTEND}vh`,
    center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
    bottom: "0",
};
const bannerOffset =
    bannerOffsetByPosition[siteConfig.wallpaper.position || "center"];

const { enabled: analyticsEnabled, code: analyticsCode } = getAnalyticsConfig();
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-(--page-bg) text-[14px] md:text-[16px] is-loading"
>
    <head>
        <meta charset="UTF-8" />
        <!-- Resource Preconnect -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="preconnect" href="https://code.iconify.design">
        <!-- Font Loader -->
        <FontLoader />
        <!-- title -->
        <title>{browserTitle}</title>
        <!-- description -->
        <meta name="description" content={description || pageTitle}>
        <!-- keywords -->
        {siteConfig.keywords && siteConfig.keywords.length > 0 && (
            <meta name="keywords" content={siteConfig.keywords.join(', ')} />
        )}
        <!-- author -->
        <meta name="author" content={profileConfig.name}>
        <!-- Open Graph -->
        <meta property="og:site_name" content={siteConfig.title}>
        <meta property="og:url" content={Astro.url}>
        <meta property="og:title" content={pageTitle}>
        <meta property="og:description" content={description || pageTitle}>
        {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
        {
            setOGTypeArticle ? (
                <meta property="og:type" content="article" />
            ) : (
                <meta property="og:type" content="website" />
            )
        }
        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image">
        <meta property="twitter:url" content={Astro.url}>
        <meta name="twitter:title" content={pageTitle}>
        <meta name="twitter:description" content={description || pageTitle}>
        <!-- viewport -->
        <meta name="viewport" content="width=device-width" />
        <!-- generator -->
        <meta name="generator" content={Astro.generator} />
        <!-- favicons -->
        {favicons.map(favicon => (
            <link rel="icon"
                  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
                  sizes={favicon.sizes}
                  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
            />
        ))}
        <!-- Set the theme before the page is rendered to avoid a flash -->
        <script is:inline define:vars={{LIGHT_MODE, DARK_MODE, SYSTEM_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, NAVBAR_HEIGHT, configHue, defaultTheme: siteConfig.defaultTheme}}>
            // Load the theme from local storage
            const theme = localStorage.getItem('theme') || defaultTheme;
            // Apply the theme to the document
            let isDark = false;
            switch (theme) {
                case LIGHT_MODE:
                    document.documentElement.classList.remove('dark');
                    isDark = false;
                    break
                case DARK_MODE:
                    document.documentElement.classList.add('dark');
                    isDark = true;
                    break
                case SYSTEM_MODE:
                    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                        document.documentElement.classList.add('dark');
                        isDark = true;
                    } else {
                        document.documentElement.classList.remove('dark');
                        isDark = false;
                    }
            }
            const expressiveTheme = isDark ? "github-dark" : "github-light";
            document.documentElement.setAttribute("data-theme", expressiveTheme);
            // Load the hue from local storage
            const hue = localStorage.getItem('hue') || configHue;
            // Apply the hue to the document
            document.documentElement.style.setProperty('--hue', hue);
            // calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
            let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
            offset = offset - offset % 4;
            document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
        </script>
        <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->
        <style define:vars={{
            configHue,
            'page-width': `${PAGE_WIDTH}rem`,
        }}></style>
        <!-- custom head -->
        <slot name="head"></slot>
        <!-- Pio mascot styles - loaded only when enabled -->
        {pioConfig.enable && <link rel="stylesheet" href="/pio/static/pio.css" />}
        <!-- rss feed -->
        <link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>
    </head>

    <body class=" min-h-screen " class:list={[{"is-home": isHomePage, "enable-banner": enableBanner}]}
    >
        <!-- Page loading animation -->
        <LoadingOverlay />
        <!-- Global config carrier -->
        <ConfigCarrier />
        <!-- Page-top gradient highlight effect - shown only in full and semifull modes -->
        {shouldShowTopHighlight && <div class="top-gradient-highlight"></div>}
        <!-- Page content -->
        <slot />
        <!-- Cookie consent — only shown when there is non-essential tracking
             (analytics) to consent to. With analytics disabled the site sets
             no non-essential cookies, so no banner is required. -->
        {analyticsEnabled && analyticsCode && (
            <CookieConsent analyticsEnabled={analyticsEnabled} analyticsCode={analyticsCode} />
        )}
        <!-- Music Player - loaded only when enabled -->
        {musicPlayerConfig.enable && <MusicPlayer client:idle />}
        <!-- Pio mascot component - z-index may need adjusting if the sidebar is enabled -->
        {pioConfig.enable && <Pio client:visible />}
        <!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
        <div id="page-height-extend" class="hidden h-[300vh]"></div>
    </body>
</html>


<style is:global define:vars={{
    'navbar-height': `${NAVBAR_HEIGHT / 16}rem`,
    'navbar-gap': `${NAVBAR_GAP}rem`,
    'navbar-follow-distance': `${NAVBAR_FOLLOW_DISTANCE}rem`,
    'main-panel-overlaps-banner-height': `${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem`,
    'sidebar-top': `${SIDEBAR_TOP}rem`,
    'sidebar-spacing': `${SIDEBAR_SPACING}rem`,
    bannerOffset,
    'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
    'banner-height': `${BANNER_HEIGHT}vh`,
}}>
@reference "../styles/main.css";
@layer components {
    /* Base CSS variables for main content top and top-row height */
    :root {
        --main-content-top: calc(var(--navbar-height) + var(--navbar-gap) + var(--navbar-follow-distance));
        --top-row-height: calc(var(--main-content-top) - var(--navbar-gap));
        --sidebar-top: var(--sidebar-top);
        --sidebar-spacing: var(--sidebar-spacing);
    }
    /* Banner mode overrides */
    body.enable-banner {
        --main-content-top: calc(var(--banner-height) - var(--main-panel-overlaps-banner-height));
        --top-row-height: calc(var(--main-content-top) - var(--navbar-gap));
    }
    html.banner-hiding body.enable-banner {
        --main-content-top: calc(var(--navbar-height) + var(--navbar-gap) + var(--navbar-follow-distance)) !important;
        --top-row-height: calc(var(--main-content-top) - var(--navbar-gap)) !important;
    }
    /* Home page with Banner mode overrides */
    body.enable-banner.is-home {
        --main-content-top: calc(var(--banner-height) - var(--main-panel-overlaps-banner-height) + var(--banner-height-extend, 36vh));
        --top-row-height: calc(var(--main-content-top) - var(--navbar-gap));
    }
    html.banner-hiding body.enable-banner.is-home {
        --main-content-top: calc(var(--navbar-height) + var(--navbar-gap) + var(--navbar-follow-distance)) !important;
        --top-row-height: calc(var(--main-content-top) - var(--navbar-gap)) !important;
    }

    .enable-banner.is-home #banner-wrapper {
        @apply h-(--banner-height-home) translate-y-(--banner-height-extend)
    }
    .enable-banner #banner-wrapper {
        @apply h-(--banner-height-home)
    }
    .enable-banner.is-home #banner {
        @apply h-(--banner-height-home) translate-y-0
    }
    .enable-banner #banner {
        @apply h-(--banner-height-home) translate-y-(--bannerOffset)
    }
}
</style>


<script>
import {
    BANNER_HEIGHT,
    BANNER_HEIGHT_HOME,
    BANNER_HEIGHT_EXTEND,
} from "@/constants/constants";
import {
    BREAKPOINT_MD,
    BREAKPOINT_LG,
} from "@constants/breakpoints";
import { widgetManager, getComponentConfig } from "@utils/widget";
import { pathsEqual, url } from "@utils/url";
import { initWallpaperMode } from "@utils/wallpaper";
import { initTheme } from "@utils/theme";
import { initHue } from "@utils/hue";
import { initMarkdownActions } from "@/utils/markdown";
import { initFancybox, cleanupFancybox } from "@utils/fancybox";
import { loadAndInitTranslate } from "@utils/language";
import { setupParticleEffects } from "@/utils/particle";


// Initialize Swup
const setup = () => {
    let pausedElementIds = new Set();
    window.swup.hooks.on('content:replace', () => {
        // Update main grid layout class name after page transition
        const gridClassCarrier = document.getElementById("grid-class-carrier");
        if (gridClassCarrier) {
            const gridClass = gridClassCarrier.getAttribute("data-grid-class");
            const mainGrid = document.getElementById("main-grid");
            if (mainGrid && gridClass) {
                const currentClasses = mainGrid.className.split(" ");
                const newClasses = currentClasses.filter(c => !c.startsWith("lg:grid-cols-") && !c.startsWith("md:grid-cols-") && !c.startsWith("grid-cols-"));
                const gridClasses = gridClass.split(" ");
                mainGrid.className = [...newClasses, ...gridClasses].join(" ");
            }
        }
        // Restore pause-swup-transition class to newly replaced persistent elements
        pausedElementIds.forEach(id => {
            const el = document.getElementById(id as string);
            if (el && el.hasAttribute('data-swup-persist')) {
                el.classList.add('pause-swup-transition');
            }
        });
    })
    window.swup.hooks.on('visit:start', (visit: {to: {url: string}}) => {
        // Disable scroll protection when a link is clicked to prevent interference with page jump scrolling to top
        if ((window as any).scrollProtectionManager && typeof (window as any).scrollProtectionManager.disable === 'function') {
            (window as any).scrollProtectionManager.disable();
        }
        // Change banner height immediately when a link is clicked
        const bodyElement = document.querySelector('body')
        const isHomePage = pathsEqual(visit.to.url, url('/'))
        if (isHomePage) {
            bodyElement!.classList.add('is-home');
        } else {
            bodyElement!.classList.remove('is-home');
        }
        // Control banner text visibility based on page
        const bannerTextOverlay = document.querySelector('.banner-text-overlay')
        if (bannerTextOverlay) {
            if (isHomePage) {
                bannerTextOverlay.classList.remove('hidden')
            } else {
                bannerTextOverlay.classList.add('hidden')
            }
        }
        // Increase the page height during page transition to prevent the scrolling animation from jumping
        const heightExtend = document.getElementById('page-height-extend')
        if (heightExtend) {
            heightExtend.classList.remove('hidden')
        }
        // Handle animation logic for persistent sidebar components
        const currentPath = window.location.pathname;
        const nextPath = visit.to.url;
        pausedElementIds.clear();
        const width = window.innerWidth;
        const deviceType = width >= BREAKPOINT_LG ? 'desktop' : (width >= BREAKPOINT_MD ? 'tablet' : 'mobile');
        const configCarrier = widgetManager.getConfig();
        const sideComponents = {
            left: configCarrier.components.left || [],
            right: configCarrier.components.right || []
        };
        ['left', 'right', 'middle'].forEach(side => {
            const allComponents = [
                ...widgetManager.getComponentsBySideAndPosition(side as any, "top"),
                ...widgetManager.getComponentsBySideAndPosition(side as any, "sticky")
            ];
            let layoutShifted = false;
            allComponents.forEach(config => {
                if (deviceType === 'desktop') {
                    if (side === 'left' && !sideComponents.left.includes(config)) return;
                    if (side === 'right' && !sideComponents.right.includes(config)) return;
                }
                const isVisibleNow = widgetManager.isVisible(config, currentPath, deviceType);
                const isVisibleNext = widgetManager.isVisible(config, nextPath, deviceType);
                const elementId = config.type === "toc" ? `toc-wrapper-${side}` : `${config.type}-${side}`;
                const el = document.getElementById(elementId);
                if (el && el.hasAttribute('data-swup-persist')) {
                    if (config.type !== "toc" && isVisibleNow && isVisibleNext && !layoutShifted) { // TOC special case: since its content always changes, pausing the animation is not recommended
                        el.classList.add('pause-swup-transition');
                        pausedElementIds.add(el.id);
                    } else {
                        el.classList.remove('pause-swup-transition');
                    }
                }
                if (isVisibleNow !== isVisibleNext) {
                    layoutShifted = true;
                }
            });
        });
    });
    window.swup.hooks.on('visit:end', (_visit: {to: {url: string}}) => {
        setTimeout(() => {
            const heightExtend = document.getElementById('page-height-extend')
            if (heightExtend) {
                heightExtend.classList.add('hidden')
            }
        }, 300)
    });
    window.swup.hooks.on('page:view', () => {
        // Scroll to top of the page after page transition
        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });
        // Check if the current page is a post page, if so, trigger a custom event to initialize the comment system
        setTimeout(() => {
            if (document.getElementById('tcomment')) {
                const pageLoadedEvent = new CustomEvent('twilight:page:loaded', {
                    detail: {
                        path: window.location.pathname,
                        timestamp: Date.now()
                    }
                });
                document.dispatchEvent(pageLoadedEvent);
            }
        }, 300);
        // Initialize Fancybox
        initFancybox();
    });
    initFancybox();
    window.swup.hooks.on("content:replace", () => {
            cleanupFancybox();
        },
        { before: true },
    )
}
if (window?.swup?.hooks) {
    setup()
} else {
    document.addEventListener('swup:enable', setup)
}

// Initialize the back-to-top button element, used to control its show/hide
let backToTopBtn = document.getElementById('back-to-top-btn');
// Throttle function
function throttle(func: (...args: any[]) => void, limit: number) {
    let inThrottle: boolean;
    return function(this: any, ...args: any[]) {
        if (!inThrottle) {
            func.apply(this, args);
            inThrottle = true;
            setTimeout(() => inThrottle = false, limit);
        }
    }
}
// Scroll event handler, controls the back-to-top button and banner hiding
function scrollFunction() {
    const scrollTop = document.documentElement.scrollTop;
    const bannerHeight = window.innerHeight * (BANNER_HEIGHT / 100);
    // Batch DOM operations
    requestAnimationFrame(() => {
        if (backToTopBtn) {
            if (scrollTop > bannerHeight) {
                backToTopBtn.classList.remove('hide')
            } else {
                backToTopBtn.classList.add('hide')
            }
        }
    });
}
// Use throttling to optimize scroll performance
window.onscroll = throttle(scrollFunction, 16); // ~60fps
// Listen for window resize events to update banner-height-related CSS variables
window.onresize = () => {
    // calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
    let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
    offset = offset - offset % 4;
    document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
}

// Initialize theme
initTheme();

// Initialize hue
initHue();

// Initialize wallpaper mode
initWallpaperMode();

// Initialize Markdown-related operations to prevent them breaking under Swup's no-refresh navigation
initMarkdownActions();

// Initialize translate.js
loadAndInitTranslate();

// Initialize particle effects
setupParticleEffects();

// Remove is-loading class and trigger initial-animation after page load
if (typeof window !== 'undefined') {
    const onPageLoaded = () => {
        const overlay = document.getElementById('loading-overlay');
        const enableBanner = document.body.classList.contains('enable-banner');
        // Trigger the LoadingOverlay fade-out
        if (overlay) {
            overlay.classList.add('fade-out');
        }
        // Wait for the LoadingOverlay fade-out (600ms)
        setTimeout(() => {
            if (overlay) {
                overlay.style.display = 'none';
            }
            if (enableBanner) {
                // Banner begins its restore transition: add the banner-restoring class (releases height: 0 in CSS)
                document.documentElement.classList.add('banner-restoring');
                // Wait for the banner restore transition to finish (600ms)
                setTimeout(() => {
                    // Trigger the fade-in animation for each container
                    document.documentElement.classList.remove('is-loading');
                    document.documentElement.classList.add('show-initial-animation');
                    setTimeout(() => {
                        document.documentElement.classList.remove('show-initial-animation');
                        document.documentElement.classList.remove('banner-restoring');
                    }, 1200);
                }, 600);
            } else {
                // Non-banner mode: trigger fade-in directly
                document.documentElement.classList.remove('is-loading');
                document.documentElement.classList.add('show-initial-animation');
                setTimeout(() => {
                    document.documentElement.classList.remove('show-initial-animation');
                }, 1200);
            }
        }, 600);
    };

    const configCarrier = document.getElementById('config-carrier');
    const waitForAllResources = configCarrier?.dataset.waitForAllResources === 'true';

    if (waitForAllResources) {
        if (document.readyState === 'complete') {
            onPageLoaded();
        } else {
            window.addEventListener('load', onPageLoaded);
        }
    } else {
        if (document.readyState !== 'loading') {
            onPageLoaded();
        } else {
            document.addEventListener('DOMContentLoaded', onPageLoaded);
        }
    }
}
</script>